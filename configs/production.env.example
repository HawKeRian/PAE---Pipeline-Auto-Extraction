PAE_ENVIRONMENT=production
PAE_LOG_LEVEL=INFO
PAE_STRUCTURED_LOGGING=true
PAE_ENABLE_MOCK_UI=false
PAE_AI_PROVIDER=ollama
PAE_AI_MODEL=llama3.1:8b
# Use host.containers.internal when Ollama runs on the Podman host.
PAE_OLLAMA_BASE_URL=http://host.containers.internal:11434
PAE_READINESS_REQUIRE_MODEL=true
PAE_BOOTSTRAP_USER_ID=local-admin
PAE_BOOTSTRAP_USER_NAME=Local Administrator
# Set this only in configs/production.env with a generated high-entropy value. Never commit it.
PAE_BOOTSTRAP_TOKEN=
PAE_DATABASE_ALLOWED_HOSTS=
PAE_DATABASE_ALLOW_PRIVATE_HOSTS=false
PAE_RATE_LIMIT_REQUESTS=300
PAE_RATE_LIMIT_WINDOW_SECONDS=60
PAE_ALERT_QUEUE_DEPTH=15
# Required before public release; set only in ignored production.env or the platform secret store.
PAE_ALERT_WEBHOOK_URL=
PAE_ALERT_WEBHOOK_TIMEOUT_SECONDS=3
PAE_ALERT_WEBHOOK_COOLDOWN_SECONDS=300
