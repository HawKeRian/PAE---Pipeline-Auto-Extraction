PAE_APP_NAME=Pipeline Auto Extraction
PAE_ENVIRONMENT=development
PAE_LOG_LEVEL=INFO
PAE_ENABLE_MOCK_UI=false
PAE_MODEL_PATH=
PAE_AI_PROVIDER=ollama
PAE_AI_MODEL=llama3.1:8b
PAE_OLLAMA_BASE_URL=http://127.0.0.1:11434
PAE_AI_TIMEOUT_SECONDS=120
PAE_DATA_DIR=./data
PAE_GENERATED_DIR=./generated
PAE_DATABASE_PATH=./data/pae.sqlite3
PAE_QUEUE_CAPACITY=20
PAE_BOOTSTRAP_USER_ID=local-admin
PAE_BOOTSTRAP_USER_NAME=Local Administrator
# Generate a high-entropy local token and keep it only in .env; never commit its value.
PAE_BOOTSTRAP_TOKEN=
PAE_MAX_UPLOAD_BYTES=52428800
PAE_MAX_SAMPLE_ROWS=100000
PAE_MAX_SAMPLE_COLUMNS=1000
PAE_SAMPLE_RETENTION_HOURS=24
PAE_DATABASE_ALLOWED_HOSTS=
PAE_DATABASE_ALLOW_PRIVATE_HOSTS=false
PAE_DATABASE_QUERY_TIMEOUT_SECONDS=30
PAE_DATABASE_SAMPLE_ROWS=10000
PAE_SANDBOX_TIMEOUT_SECONDS=5
PAE_SANDBOX_MEMORY_MB=256
PAE_SANDBOX_CPU_SECONDS=5
PAE_SANDBOX_OUTPUT_MB=5
PAE_RATE_LIMIT_REQUESTS=300
PAE_RATE_LIMIT_WINDOW_SECONDS=60
PAE_READINESS_REQUIRE_MODEL=false
PAE_READINESS_MODEL_TIMEOUT_SECONDS=2
PAE_ALERT_QUEUE_DEPTH=15
# Optional HTTPS webhook. Keep credential-bearing URLs only in ignored environment files.
PAE_ALERT_WEBHOOK_URL=
PAE_ALERT_WEBHOOK_TIMEOUT_SECONDS=3
PAE_ALERT_WEBHOOK_COOLDOWN_SECONDS=300
PAE_STRUCTURED_LOGGING=true
# Database passwords are resolved at runtime from secret references. Example:
# PAE_SECRET_WAREHOUSE_READ_ONLY=replace-in-local-dot-env-only
